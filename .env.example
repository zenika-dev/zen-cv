# Copy to .env.local (ignored by git) and fill in.

# Dev database used by `pnpm dev`, `pnpm start`, `pnpm db:migrate` and `pnpm db:seed`.
# Local Docker database (`pnpm db:local:init`): postgresql://postgres:test@localhost:5499/postgres
# Through the Cloud SQL Auth Proxy: postgresql://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=

# Test database. Optional for `pnpm test:unit`: enables the Postgres tests, which run in a
# temporary schema dropped afterwards. Required for `pnpm test:e2e`, which resets and uses the
# `e2e` schema. The local Docker database can serve both, since the app uses the `public` schema:
# postgresql://postgres:test@localhost:5499/postgres. Never the Cloud SQL dev database.
TEST_DATABASE_URL=

# Signed-in user locally, where there is no IAP. Defaults to dev@localhost.
DEV_USER_EMAIL=
# Optional job title of that user: `Business Developer` lets you edit every CV.
DEV_USER_TITLE=
